<?xml version="1.0" encoding="utf-8"?>
<!--
    API 27+ overrides. Styles resolve as a whole resource per configuration, so
    each style is repeated in full here with the API 27 attributes added:
      - android:windowLightNavigationBar        (added in API 27)
      - android:windowLayoutInDisplayCutoutMode (added in API 27)
-->
<resources>
    <style name="Theme.NovaVM" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/novavm_background</item>
        <item name="android:statusBarColor">@color/novavm_background</item>
        <item name="android:navigationBarColor">@color/novavm_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.NovaVM.Fullscreen" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
